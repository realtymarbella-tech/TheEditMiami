<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>The Edit Miami — Residencias Curadas</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Jost:wght@300;400;500;600&display=swap">
<style>
/* ══ TOKENS — The Edit Miami Design System (sin modificar) ══ */
:root{
  --charcoal-950:#121210;--charcoal-900:#1C1C1A;--charcoal-700:#3D3C38;--charcoal-500:#706E69;
  --charcoal-400:#8A8278;--charcoal-200:#D0C9C0;--charcoal-100:#E8E3DC;--charcoal-50:#F3F0EB;
  --cream:#FDFCFB;--cream-2:#F8F5F0;
  --sunset:#F5A95C;--sunset-dk:#D98B3F;--sunset-lt:#FCE8D2;
  --ocean:#0C2430;--ocean-dk:#071A23;
  --aqua:#2AB5AE;--aqua-lt:#7FD8D0;--aqua-100:#D8F2EF;
  --flamingo:#E96A8D;--flamingo-100:#FBE3EA;
  --serif:'Cormorant Garamond',Georgia,serif;
  --sans:'Jost',-apple-system,sans-serif;
  --page-x:clamp(24px,6vw,80px);
  --ease:cubic-bezier(0.16,1,0.3,1);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
/* IDEA 4 — el body muta de color entre secciones */
body{font-family:var(--sans);color:var(--charcoal-900);line-height:1.6;
  background:var(--charcoal-950);transition:background-color .9s var(--ease)}
body.bg-cream{background:var(--cream)}
body.bg-elle{background:#FBF4F2}
body.bg-domus{background:#F2F7F6}
body.bg-dark{background:var(--charcoal-950)}
a{color:inherit;text-decoration:none}
section{padding:clamp(72px,10vw,140px) var(--page-x);background:transparent}

/* ══ NAV ══ */
nav{position:sticky;top:0;z-index:100;background:var(--charcoal-950);border-bottom:1px solid rgba(255,255,255,.07);
  height:68px;display:flex;align-items:center;padding:0 var(--page-x);gap:40px}
.nav-logo{font-family:var(--serif);font-size:21px;font-weight:300;letter-spacing:.18em;text-transform:uppercase;color:var(--cream)}
.nav-logo em{font-style:italic;color:var(--aqua-lt)}
.nav-links{display:flex;gap:32px;flex:1;justify-content:flex-end}
.nav-links a{font-size:11px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--charcoal-200);transition:color .2s}
.nav-links a:hover{color:var(--cream)}
.nav-cta{font-size:11px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;
  background:var(--aqua);color:var(--ocean);padding:11px 26px;transition:background .24s}
.nav-cta:hover{background:#1F9993}
@media(max-width:820px){.nav-links{display:none}}

/* ══ HERO — split editorial + featured stack ══ */
.hero{display:grid;grid-template-columns:1.1fr 1fr;height:calc(100vh - 68px);min-height:640px;background:var(--charcoal-950);gap:2px}
.hero-left{position:relative;overflow:hidden;display:flex;align-items:center}
.hero-left-bg{position:absolute;inset:0;
  background:linear-gradient(160deg,#1a2b38 0%,#0C2430 40%,#071A23 100%);}
.hero-left-bg::after{content:'';position:absolute;inset:0;
  background:
   radial-gradient(ellipse 90% 55% at 50% 108%, rgba(245,169,92,.32), transparent 60%),
   repeating-linear-gradient(90deg, transparent 0 46px, rgba(255,255,255,.028) 46px 49px),
   repeating-linear-gradient(0deg, transparent 0 26px, rgba(255,255,255,.02) 26px 28px);}
.hero-left-scrim{position:absolute;inset:0;background:linear-gradient(100deg,rgba(18,18,16,.9) 0%,rgba(18,18,16,.45) 55%,rgba(18,18,16,.1) 100%)}
.hero-content{position:relative;z-index:1;padding:0 clamp(28px,5vw,72px);display:flex;flex-direction:column;gap:22px}
.hero-overline{font-size:11px;font-weight:500;letter-spacing:.26em;text-transform:uppercase;color:var(--charcoal-200)}
.hero-title{font-family:var(--serif);font-size:clamp(42px,4.8vw,68px);font-weight:400;color:var(--cream);line-height:1.1;letter-spacing:-.01em}
.hero-title em{font-style:italic;font-weight:300}
.hero-sub{font-size:15px;font-weight:300;color:var(--charcoal-200);max-width:420px;line-height:1.7}
.hero-actions{display:flex;gap:16px;flex-wrap:wrap;margin-top:6px}
.btn{display:inline-block;font-size:11px;font-weight:500;letter-spacing:.15em;text-transform:uppercase;padding:14px 34px;transition:all .24s var(--ease);border:none;cursor:pointer}
.btn-accent{background:var(--aqua);color:var(--ocean)}
.btn-accent:hover{background:#1F9993}
.btn-outline{background:transparent;color:var(--cream);border:1px solid rgba(253,252,251,.5)}
.btn-outline:hover{background:var(--cream);color:var(--charcoal-950)}
.hero-right{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:3fr 2fr;gap:2px}
.feat{position:relative;overflow:hidden;cursor:pointer;display:flex;align-items:flex-end;background:var(--charcoal-900)}
.feat.main{grid-column:1/3}
.feat-bg{position:absolute;inset:0;transition:transform .5s var(--ease)}
.feat:hover .feat-bg{transform:scale(1.045)}
.feat.cip .feat-bg{background:linear-gradient(170deg,#2c3a45 0%,#131e26 70%),
  repeating-linear-gradient(90deg,transparent 0 22px,rgba(245,169,92,.06) 22px 24px)}
.feat.elle .feat-bg{background:linear-gradient(170deg,#3d2b33 0%,#1c1216 70%),
  repeating-linear-gradient(90deg,transparent 0 18px,rgba(233,106,141,.06) 18px 20px)}
.feat.dom .feat-bg{background:linear-gradient(170deg,#22343a 0%,#0f1c20 70%),
  repeating-linear-gradient(90deg,transparent 0 18px,rgba(42,181,174,.06) 18px 20px)}
.feat-overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(18,18,16,.88) 0%,rgba(18,18,16,.2) 50%,transparent 75%)}
.feat-body{position:relative;z-index:1;padding:22px 24px;display:flex;flex-direction:column;gap:3px;width:100%}
.feat-name{font-size:16px;font-weight:500;letter-spacing:.09em;text-transform:uppercase;color:var(--cream)}
.feat.main .feat-name{font-size:23px}
.feat-meta{font-size:10.5px;font-weight:400;letter-spacing:.14em;text-transform:uppercase}
.feat.cip .feat-meta{color:var(--sunset)}
.feat.elle .feat-meta{color:var(--flamingo)}
.feat.dom .feat-meta{color:var(--aqua-lt)}
.feat-price{font-size:13px;font-weight:300;color:var(--charcoal-200);margin-top:4px}
.feat::after{content:'';position:absolute;inset:0;border:1px solid transparent;transition:border-color .3s;pointer-events:none}
.feat.cip:hover::after{border-color:rgba(245,169,92,.6)}
.feat.elle:hover::after{border-color:rgba(233,106,141,.55)}
.feat.dom:hover::after{border-color:rgba(42,181,174,.55)}
@media(max-width:960px){
  .hero{grid-template-columns:1fr;height:auto}
  .hero-left{min-height:70vh}
  .hero-right{min-height:60vh}
}

/* ══ STATS BAR ══ */
.statsbar{background:var(--ocean);color:var(--cream);padding:30px var(--page-x);display:flex;border-top:1px solid rgba(255,255,255,.08)}
.stat{flex:1;padding:0 32px;border-right:1px solid rgba(255,255,255,.1);display:flex;flex-direction:column;gap:4px}
.stat:first-child{padding-left:0}.stat:last-child{border-right:none}
.stat-num{font-family:var(--serif);font-size:38px;font-weight:300;color:var(--aqua-lt)}
.stat-label{font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--charcoal-200)}
@media(max-width:760px){.statsbar{flex-wrap:wrap;gap:20px}.stat{flex:1 1 40%;border:none;padding:0}}

/* ══ SECCIONES PROYECTO ══ */
.proj{display:grid;grid-template-columns:1fr 1fr;gap:clamp(40px,6vw,90px);align-items:center;max-width:1280px;margin:0 auto}
.proj.flip .proj-media{order:2}
@media(max-width:900px){.proj{grid-template-columns:1fr}.proj.flip .proj-media{order:0}}
.overline{font-size:10.5px;font-weight:500;letter-spacing:.26em;text-transform:uppercase;margin-bottom:14px}
.proj-title{font-family:var(--serif);font-size:clamp(34px,4vw,54px);font-weight:300;line-height:1.12;letter-spacing:-.01em;margin-bottom:8px}
.proj-title em{font-style:italic}
.proj-tag{font-family:var(--serif);font-style:italic;font-size:19px;font-weight:300;color:var(--charcoal-500);margin-bottom:22px}
.proj-body{font-size:15.5px;font-weight:300;line-height:1.8;color:var(--charcoal-500);margin-bottom:26px;max-width:520px}
.proj-stats{font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--charcoal-400);display:flex;flex-wrap:wrap;gap:8px 0;margin-bottom:30px}
.proj-stats span{white-space:nowrap}
.proj-stats .dot{margin:0 12px}
.link{font-size:11.5px;font-weight:500;letter-spacing:.16em;text-transform:uppercase;padding-bottom:6px;border-bottom:1px solid currentColor;transition:opacity .2s}
.link:hover{opacity:.6}
.c-sun{color:var(--sunset-dk)}.c-flam{color:#C94C72}.c-aqua{color:#1F9993}

/* IDEA 1 — torre que se construye al scroll */
.proj-media{position:relative}
.tower-frame{position:relative;aspect-ratio:3/4;max-height:640px;overflow:hidden;border:1px solid var(--charcoal-100);background:var(--charcoal-50)}
.tower{position:absolute;inset:0;clip-path:inset(100% 0 0 0);transition:clip-path 2.2s var(--ease)}
.tower-frame.built .tower{clip-path:inset(0 0 0 0)}
.tower.t-cip{background:
  linear-gradient(180deg,#8fa3b0 0%,#5c7484 30%,#31434f 100%);}
.tower.t-cip::after{content:'';position:absolute;inset:0;
  background:repeating-linear-gradient(0deg,transparent 0 14px,rgba(255,255,255,.14) 14px 15px),
  repeating-linear-gradient(90deg,transparent 0 30px,rgba(12,36,48,.25) 30px 32px);
  clip-path:polygon(28% 4%,72% 4%,78% 100%,22% 100%)}
.tower.t-elle{background:linear-gradient(180deg,#d9a9b6 0%,#a26a7c 35%,#4a2c37 100%)}
.tower.t-elle::after{content:'';position:absolute;inset:0;
  background:repeating-linear-gradient(0deg,transparent 0 20px,rgba(255,255,255,.16) 20px 21.5px),
  repeating-linear-gradient(90deg,transparent 0 26px,rgba(28,18,22,.28) 26px 28px);
  clip-path:polygon(30% 12%,70% 12%,70% 100%,30% 100%)}
.tower.t-dom{background:linear-gradient(180deg,#9fc4c0 0%,#5b8a86 35%,#20403d 100%)}
.tower.t-dom::after{content:'';position:absolute;inset:0;
  background:repeating-linear-gradient(0deg,transparent 0 17px,rgba(255,255,255,.15) 17px 18.5px),
  repeating-linear-gradient(90deg,transparent 0 34px,rgba(15,28,32,.3) 34px 36px);
  clip-path:polygon(26% 9%,74% 9%,74% 100%,26% 100%)}
.media-note{position:absolute;bottom:14px;left:14px;font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.55)}
.counter-chip{position:absolute;top:20px;right:20px;background:rgba(18,18,16,.82);color:var(--cream);
  padding:12px 18px;font-family:var(--serif);font-size:30px;font-weight:300;line-height:1;backdrop-filter:blur(6px)}
.counter-chip small{display:block;font-family:var(--sans);font-size:9.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--charcoal-200);margin-top:5px}
blockquote{font-family:var(--serif);font-style:italic;font-size:21px;font-weight:300;color:var(--charcoal-700);
  border-left:1px solid var(--sunset);padding-left:22px;margin-bottom:30px;line-height:1.5}
blockquote cite{display:block;font-family:var(--sans);font-style:normal;font-size:10.5px;letter-spacing:.18em;text-transform:uppercase;color:var(--charcoal-400);margin-top:10px}

/* ══ IDEA 6 — COMPARADOR A ESCALA ══ */
.compare{max-width:1180px;margin:0 auto;text-align:center}
.compare h2{font-family:var(--serif);font-size:clamp(30px,3.6vw,48px);font-weight:300;margin-bottom:10px}
.compare p{font-size:14.5px;font-weight:300;color:var(--charcoal-500);max-width:520px;margin:0 auto 56px}
.skyline{display:flex;align-items:flex-end;justify-content:center;gap:clamp(28px,6vw,90px);height:480px;border-bottom:1px solid var(--charcoal-200);padding:0 20px}
.sil{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;cursor:pointer}
.sil svg{display:block;transition:all .4s var(--ease)}
.sil svg .fill{fill:var(--charcoal-100);transition:fill .4s}
.sil svg .line{stroke:var(--charcoal-400);stroke-width:1.5;fill:none;transition:stroke .4s}
.sil:hover svg{transform:translateY(-6px)}
.sil.s-cip:hover .fill{fill:var(--sunset-lt)}.sil.s-cip:hover .line{stroke:var(--sunset-dk)}
.sil.s-elle:hover .fill{fill:var(--flamingo-100)}.sil.s-elle:hover .line{stroke:var(--flamingo)}
.sil.s-dom:hover .fill{fill:var(--aqua-100)}.sil.s-dom:hover .line{stroke:var(--aqua)}
.sil-info{position:absolute;bottom:calc(100% + 10px);left:50%;transform:translate(-50%,8px);opacity:0;pointer-events:none;
  background:var(--charcoal-950);color:var(--cream);padding:14px 20px;min-width:210px;transition:all .35s var(--ease);text-align:left}
.sil:hover .sil-info{opacity:1;transform:translate(-50%,0)}
.sil-info b{display:block;font-size:12px;letter-spacing:.1em;text-transform:uppercase;margin-bottom:5px}
.sil-info span{display:block;font-size:11.5px;font-weight:300;color:var(--charcoal-200);line-height:1.6}
.sil-label{margin-top:16px;font-size:11px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--charcoal-700)}
.sil-ft{font-family:var(--serif);font-size:22px;font-weight:300;color:var(--charcoal-500)}
@media(max-width:700px){.skyline{height:340px;gap:24px}}

/* ══ CONTACTO ══ */
.contact{background:var(--charcoal-950);color:var(--cream)}
.contact-inner{max-width:640px;margin:0 auto;text-align:center}
.contact h2{font-family:var(--serif);font-size:clamp(32px,4vw,50px);font-weight:300;margin-bottom:12px}
.contact h2 em{font-style:italic;color:var(--aqua-lt)}
.contact p{font-size:14.5px;font-weight:300;color:var(--charcoal-200);margin-bottom:44px}
form{display:grid;grid-template-columns:1fr 1fr;gap:14px;text-align:left}
input,select{background:transparent;border:1px solid var(--charcoal-700);color:var(--cream);
  padding:15px 16px;font-family:var(--sans);font-size:13.5px;font-weight:300;width:100%;transition:border-color .2s}
input::placeholder{color:var(--charcoal-400)}
input:focus,select:focus{outline:none;border-color:var(--aqua)}
select{appearance:none;color:var(--charcoal-400)}
.span2{grid-column:1/3}
form .btn{grid-column:1/3;margin-top:8px}
@media(max-width:560px){form{grid-template-columns:1fr}.span2,form .btn{grid-column:1}}

/* ══ FOOTER ══ */
footer{background:var(--ocean-dk);color:var(--charcoal-200);padding:56px var(--page-x) 32px;border-top:1px solid var(--aqua)}
.foot{display:grid;grid-template-columns:2fr 1fr 1fr;gap:48px;max-width:1280px;margin:0 auto 40px}
.foot h4{font-family:var(--serif);font-size:19px;font-weight:300;letter-spacing:.14em;text-transform:uppercase;color:var(--cream);margin-bottom:14px}
.foot h5{font-size:10.5px;font-weight:500;letter-spacing:.2em;text-transform:uppercase;color:var(--aqua);margin-bottom:14px}
.foot a,.foot p{display:block;font-size:13px;font-weight:300;color:var(--charcoal-200);line-height:2}
.foot a:hover{color:var(--cream)}
.legal{max-width:1280px;margin:0 auto;padding-top:24px;border-top:1px solid rgba(255,255,255,.08);
  font-size:10.5px;font-weight:300;color:var(--charcoal-500);line-height:1.7}
@media(max-width:760px){.foot{grid-template-columns:1fr;gap:32px}}

/* ══ REVEALS ══ */
.rev{opacity:0;transform:translateY(26px);transition:opacity .8s var(--ease),transform .8s var(--ease)}
.rev.in{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){
  *{transition:none!important;animation:none!important}
  .tower{clip-path:inset(0 0 0 0)!important}
  .rev{opacity:1;transform:none}
}
</style>
</head>
<body class="bg-dark">

<nav>
  <a class="nav-logo" href="#">The <em>Edit</em> Miami</a>
  <div class="nav-links">
    <a href="#cipriani">Cipriani</a><a href="#elle">Elle Residences</a><a href="#domus">Domus Brickell</a><a href="#comparar">Comparar</a>
