<script>
// ══ IDEA 4 — transición de color del body entre secciones ══
const bgSections=document.querySelectorAll('[data-bg]');
const bgObs=new IntersectionObserver(es=>{
  es.forEach(e=>{if(e.isIntersecting){
    document.body.className=e.target.dataset.bg;
  }});
},{rootMargin:'-45% 0px -45% 0px'});
bgSections.forEach(s=>bgObs.observe(s));

// ══ Reveals ══
const revObs=new IntersectionObserver(es=>{
  es.forEach((e,i)=>{if(e.isIntersecting){
    setTimeout(()=>e.target.classList.add('in'),(i%4)*110);
    revObs.unobserve(e.target);
  }});
},{threshold:.15});
document.querySelectorAll('.rev').forEach(el=>revObs.observe(el));

// ══ IDEA 1 — torre que se construye + contador ══
const easeOut=t=>1-Math.pow(1-t,3);
function runCounter(el,target){
  const start=performance.now(),dur=2200;
  function tick(now){
    const p=Math.min((now-start)/dur,1);
    el.textContent=Math.round(easeOut(p)*target).toLocaleString('es-ES');
    if(p<1)requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
}
const towerObs=new IntersectionObserver(es=>{
  es.forEach(e=>{if(e.isIntersecting){
    e.target.classList.add('built');
    runCounter(e.target.querySelector('.counter-num'),+e.target.dataset.count);
    towerObs.unobserve(e.target);
  }});
},{threshold:.35});
document.querySelectorAll('.tower-frame').forEach(t=>towerObs.observe(t));
</script>
